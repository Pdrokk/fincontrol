  "narrative": {
    "northStar": "Painel financeiro de trabalho",
    "overview": "Interface desktop de operação: leitura rápida de valores, ações específicas por tela e detalhes sob demanda. O conteúdo financeiro tem prioridade sobre decoração. A direção descritiva abaixo registra o sistema existente da v1.6.4; não é uma proposta de redesign.",
    "keyCharacteristics": [
      "Tema claro e escuro com superfícies neutras e ação azul.",
      "Menu lateral compacto, rótulos acessíveis e áreas de trabalho previsíveis.",
      "Valores monetários legíveis, histórico paginado e composição da carteira em rosca."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Cor nunca é a única indicação de status, ativo ou resultado financeiro.",
        "section": "colors"
      }
    ],
    "dos": [
      "Use os tokens de tema existentes para superfícies, textos, bordas e campos.",
      "Mantenha valores e percentuais acompanhados de rótulos; use BRL e pt-BR.",
      "Agrupe filtros com os resultados e mantenha as ações financeiras no contexto correto.",
      "Preserve foco visível, alternativa textual dos gráficos e estados de erro."
    ],
    "donts": [
      "Não adicione gráficos de investimentos à Visão Geral nem duplique a rosca.",
      "Não represente cotação ausente como zero ou patrimônio como rentabilidade.",
      "Não substitua as regras financeiras por cálculos exclusivos do renderer.",
      "Não introduza uma terceira paleta ou novos componentes sem necessidade comprovada."
